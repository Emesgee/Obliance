# infra/.env — the ONE secrets file on the server (ADR-0007 §5). Copy, fill,
# chmod 600. Never commit. Keep a copy in the password manager: without it (and
# the backup passphrase) an off-site backup cannot be restored (ADR-0007 §4).

APP_ENV=prod
SITE_ADDRESS=app.example.dk

# Datastores (loopback-only inside the host; Compose refuses to start without these)
POSTGRES_PASSWORD=change-me-postgres-superuser
REDIS_PASSWORD=change-me-redis

# Application roles (defaults = role name for dev ONLY; rotate in prod — see README)
CC_MIGRATOR_PASSWORD=obliance_migrator
CC_APP_PASSWORD=obliance_app
CC_WORKER_PASSWORD=obliance_worker

# Scale
WORKER_REPLICAS=1

# LLM (ADR-0008) — filled when app/llm is built. Server-side only.
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# LLM_INFERENCE_GEO=us

# Object storage (ADR-0007 §3) — filled when core/storage is ported.
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_BUCKET=obliance-prod
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Backup (ADR-0007 §4)
# BACKUP_PASSPHRASE_FILE=/root/.backup_passphrase
# STORAGEBOX_TARGET=uXXXXXX@uXXXXXX.your-storagebox.de:obliance-backups/
