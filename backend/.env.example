# Backend — local dev. Copy to .env (git-ignored). Production values live in
# infra/.env on the server only (ADR-0007 §5).

# App connects as the NON-superuser app role (RLS applies — ADR-0002).
DATABASE_URL=postgresql+psycopg://obliance_app:obliance_app@127.0.0.1:5432/obliance
# Migrations run as the schema owner.
MIGRATE_DATABASE_URL=postgresql+psycopg://obliance_migrator:obliance_migrator@127.0.0.1:5432/obliance
# Tests: same roles, separate database.
TEST_DATABASE_URL=postgresql+psycopg://obliance_app:obliance_app@127.0.0.1:5432/obliance_test

REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/0

APP_ENV=dev
LOG_LEVEL=INFO

# Auth (ADR-0024). SECRET_KEY signs access tokens; rotating it logs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start outside dev/test with the built-in dev default.
SECRET_KEY=
JWT_TTL_MINUTES=480
# Rate limiting (bidflow ADR-0009): memory:// locally, redis://... in prod.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
# Quoted: the value has spaces, and `set -a; . ./.env` in bash needs it quoted.
RATELIMIT_LOGIN="10 per minute"

# Local only (native Postgres without Docker): lets infra/postgres/native-setup.sql
# run without a password prompt. Never set in prod; never the app's own credential.
# POSTGRES_SUPERUSER_PASSWORD=
