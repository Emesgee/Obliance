# worker container (ADR-0007 §2): RQ worker + scheduler, plus the document
# toolchain (LibreOffice for docx/xlsx → PDF, bidflow ADR-0049). Built from the
# api image so code and dependencies are byte-identical.
ARG API_IMAGE=obliance-api:latest
FROM ${API_IMAGE}

USER root
RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends \
      libreoffice-writer libreoffice-calc libreoffice-impress \
      fonts-dejavu fonts-liberation \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
USER app

CMD ["python", "-m", "app.jobs.worker"]
